model WhatsappSessionKey {
  id        BigInt @id @default(autoincrement()) @db.BigInt

  sessionId BigInt @map("session_id") @db.BigInt
  session   WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  keyType   String @db.VarChar(50)
  keyId     String @map("key_id") @db.VarChar(255)
  value     Json

  updatedDate DateTime @updatedAt @map("updated_date")

  @@unique([sessionId, keyType, keyId])
  @@index([sessionId])

  @@map("whatsapp_session_keys")
}