model Reference {
  id          Int     @id @default(autoincrement()) @db.UnsignedInt
  code        String  @unique @db.VarChar(50)
  name        String  @db.VarChar(100)
  group       String  @db.VarChar(50)
  description String? @db.Text

  walletTypes           Wallet[]
  transactionTypes      Transaction[] @relation("TransactionType")
  transactionCategories Transaction[] @relation("TransactionCategory")

  @@map("reference")
}
