model Wallet {
  id             Int      @id @default(autoincrement()) @db.UnsignedInt
  userId         Int      @map("user_id") @db.UnsignedInt
  kdWallet       String   @map("kd_wallet") @db.VarChar(50)

  name           String   @db.VarChar(100)

  initialBalance Decimal  @default(0) @map("initial_balance") @db.Decimal(18,2)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(18,2)

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  type Reference @relation(fields: [kdWallet], references: [code])

  transactions         Transaction[] @relation("WalletTransaction")
  transferTransactions Transaction[] @relation("TransferWallet")
  rules                Rule[]

  @@index([userId])
  @@index([kdWallet])

  @@map("wallet")
}