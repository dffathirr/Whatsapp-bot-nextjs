model Wallet {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId         BigInt   @map("user_id") @db.UnsignedBigInt
  kdType         String   @map("kd_type") @db.VarChar(50)

  name           String   @db.VarChar(100)

  initialBalance Decimal  @default(0) @map("initial_balance") @db.Decimal(18,2)
  currentBalance Decimal  @default(0) @map("current_balance") @db.Decimal(18,2)

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  type Reference @relation(fields: [kdType], references: [code])

  transactions         Transaction[] @relation("WalletTransaction")
  transferTransactions Transaction[] @relation("TransferWallet")

  @@index([userId])
  @@index([kdType])

  @@map("wallet")
}